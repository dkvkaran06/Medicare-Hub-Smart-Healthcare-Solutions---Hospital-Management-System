# Local backend DB credentials for local testing.
#
# 1. Copy this file to  backend-local.env  (same folder).
# 2. Fill in the SAME values you set in the Render dashboard
#    (Render -> your backend service -> Environment).
# 3. Run start.bat -- it loads backend-local.env automatically.
#
# backend-local.env is gitignored and will never be committed.
#
# NOTE: these point the LOCAL backend at your REAL (Render) MySQL, so any
# records you create/edit/delete while testing locally are real production
# data. Use a local MySQL instead if you want a throwaway database.

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
